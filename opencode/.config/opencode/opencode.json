{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "ruff": {
      "command": [
        "ruff",
        "server"
      ],
      "extensions": [
        ".py"
      ]
    },
    "toml": {
      "command": [
        "tombi",
        "lsp"
      ],
      "extensions": [
        ".toml"
      ]
    },
    "ty": {
      "command": [
        "ty",
        "server"
      ],
      "extensions": [
        ".py"
      ]
    },
    "markdown": {
      "command": ["marksman", "server"],
      "extensions": ["*.md"]
    }
  },
  "mcp": {
    "zai-mcp-server": {
        "type": "local",
        "command": ["npx","-y","@z_ai/mcp-server"],
        "environment": {
            "Z_AI_API_KEY": "{env:ZAI_API_KEY}",
            "Z_AI_MODE": "ZAI"
        }
    }
  }
}
