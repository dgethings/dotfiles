{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "ruff": {
      "command": [
        "ruff",
        "server"
      ],
      "extensions": [
        ".py"
      ]
    },
    "toml": {
      "command": [
        "tombi",
        "lsp"
      ],
      "extensions": [
        ".toml"
      ]
    },
    "ty": {
      "command": [
        "ty",
        "server"
      ],
      "extensions": [
        ".py"
      ]
    },
    "markdown": {
      "command": ["marksman", "server"],
      "extensions": ["*.md"]
    }
  }
}
